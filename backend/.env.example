GOOGLE_API_KEY=your_google_api_key_here
PORT=3001
TMR_API_KEY=your_two_minute_reports_key
# Goal tracking: published MajorPace sheet (File > Share > Publish to web). Optional overrides.
# GOALS_SHEET_PUB_URL=https://docs.google.com/spreadsheets/d/e/<published-id>/pub
# GOALS_BRAND_GID=116061889
# GOALS_FX_GID=370653067

# Login (optional). Leave MAJORVIEW_USERS unset to keep the dashboard open.
# Make each password hash with: node backend/scripts/hash-password.js 'their-password'
# MAJORVIEW_USERS=[{"email":"name@majorform.co","name":"Name","password":"scrypt$..."}]
# Any long random string; keeps people logged in across restarts
# SESSION_SECRET=
